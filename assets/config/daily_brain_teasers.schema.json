{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily_brain_teasers.schema.json",
  "title": "Daily Brain Teasers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "question",
      "answer",
      "difficulty",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^t[0-9]{3}$"
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "answer": {
        "type": "string",
        "minLength": 1
      },
      "difficulty": {
        "enum": [
          "easy",
          "medium",
          "hard"
        ]
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
