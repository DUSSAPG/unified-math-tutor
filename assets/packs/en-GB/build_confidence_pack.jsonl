{"id": "bc-001", "question": "What is 4 + 3?", "options": ["6", "7", "8", "9"], "correct_index": 1, "explanation": "4 + 3 = 7. Counting on from 4: 5, 6, 7.", "topic": "Build Confidence", "difficulty": "step1"}
{"id": "bc-002", "question": "What is 9 − 4?", "options": ["4", "5", "6", "13"], "correct_index": 1, "explanation": "9 − 4 = 5. Counting back from 9: 8, 7, 6, 5.", "topic": "Build Confidence", "difficulty": "step1"}
{"id": "bc-003", "question": "What is 6 + 5?", "options": ["10", "11", "12", "13"], "correct_index": 1, "explanation": "6 + 5 = 11. Try 6 + 4 = 10, then add the last 1: 10 + 1 = 11.", "topic": "Build Confidence", "difficulty": "step1"}
{"id": "bc-004", "question": "What is 23 + 15?", "options": ["36", "37", "38", "48"], "correct_index": 2, "explanation": "23 + 15 = 38. Add the tens first: 20 + 10 = 30, then the ones: 3 + 5 = 8, then 30 + 8 = 38.", "topic": "Build Confidence", "difficulty": "step2"}
{"id": "bc-005", "question": "What is 40 − 17?", "options": ["21", "22", "23", "33"], "correct_index": 2, "explanation": "40 − 17 = 23. Think of 40 − 20 = 20, then add back 3 (since 17 is 3 less than 20): 20 + 3 = 23.", "topic": "Build Confidence", "difficulty": "step2"}
{"id": "bc-006", "question": "What is 3 × 6?", "options": ["16", "18", "21", "24"], "correct_index": 1, "explanation": "3 × 6 = 18. Three groups of six: 6 + 6 + 6 = 18.", "topic": "Build Confidence", "difficulty": "step2"}
{"id": "bc-007", "question": "What is 1/2 of 20?", "options": ["5", "10", "15", "20"], "correct_index": 1, "explanation": "Half of 20 is 10, because 20 ÷ 2 = 10.", "topic": "Build Confidence", "difficulty": "step3"}
{"id": "bc-008", "question": "What is 48 ÷ 6?", "options": ["6", "7", "8", "9"], "correct_index": 2, "explanation": "48 ÷ 6 = 8, because 6 × 8 = 48.", "topic": "Build Confidence", "difficulty": "step3"}
{"id": "bc-009", "question": "What is 1/4 of 36?", "options": ["6", "8", "9", "12"], "correct_index": 2, "explanation": "36 ÷ 4 = 9, so a quarter of 36 is 9.", "topic": "Build Confidence", "difficulty": "step3"}
{"id": "bc-010", "question": "What is 10% of 80?", "options": ["8", "10", "18", "80"], "correct_index": 0, "explanation": "10% means one tenth, so 80 ÷ 10 = 8.", "topic": "Build Confidence", "difficulty": "step4"}
{"id": "bc-011", "question": "What is 25% of 60?", "options": ["12", "15", "20", "25"], "correct_index": 1, "explanation": "25% is a quarter, so 60 ÷ 4 = 15.", "topic": "Build Confidence", "difficulty": "step4"}
{"id": "bc-012", "question": "What is 3/4 as a decimal?", "options": ["0.25", "0.5", "0.75", "1.25"], "correct_index": 2, "explanation": "3/4 means 3 divided by 4, which is 0.75.", "topic": "Build Confidence", "difficulty": "step4"}
